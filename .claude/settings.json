{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Checking edited frontend file…",
            "timeout": 60,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/frontend-check.sh edit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Typechecking + linting frontend…",
            "timeout": 120,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/frontend-check.sh stop"
          }
        ]
      }
    ]
  }
}

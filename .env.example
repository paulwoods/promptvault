# Prompt Vault — environment configuration template.
#
# Copy this file to `.env` (git-ignored) for local development. The values
# below are DEV-ONLY and safe to use locally. NEVER reuse them outside local
# development, and never commit a real `.env`.
#
# - docker-compose reads this directory's `.env` automatically for the
#   POSTGRES_* variables below.
# - The backend reads its configuration from the environment, so export these
#   into your shell before `./mvnw spring-boot:run` (e.g. `set -a; . ./.env; set +a`).

# --- Postgres container (docker-compose) ---
# The postgres image superuser database and credentials. Dev-only defaults
# match the docker-compose.yml fallbacks; override for any non-local use.
POSTGRES_DB=postgres
POSTGRES_DB_USERNAME=postgres
POSTGRES_DB_PASSWORD=postgres

# --- promptvault role & database (init-app-db.sh) ---
# init-app-db.sh runs on a fresh postgres data dir and creates the `promptvault`
# role and database the backend connects to. PROMPTVAULT_DB_PASSWORD MUST equal
# SPRING_DATASOURCE_PASSWORD below: the init script sets the role's password,
# the backend logs in with it. Dev-only values; never reuse outside local.
PROMPTVAULT_DB_USERNAME=promptvault
PROMPTVAULT_DB_PASSWORD=xxxxxxxxx

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/promptvault
SPRING_DATASOURCE_USERNAME=promptvault
SPRING_DATASOURCE_PASSWORD=xxxxxxxxx

# --- Encryption master key (ADR-0002) ---
# Base64-encoded 32 random bytes. Generate a real one with:
#   openssl rand -base64 32
# Dev-only value (do not use anywhere but local):
PROMPTVAULT_ENC_KEY=xxxxxxxx

# --- JWT signing secret (HS256, >= 256-bit) ---
# Generate a real one with:
#   openssl rand -base64 48
# Dev-only value (do not use anywhere but local):
PROMPTVAULT_JWT_SECRET=xxxxxxxx

# --- Google sign-in (ADR-0011) ---
# OAuth 2.0 "Web application" client ID from the Google Cloud Console, with
# http://localhost:5173 registered as an Authorized JavaScript origin. See
# "Getting a Google client ID" in README.md for how to create one. Not a secret
# (the browser sees it), and there is no client secret. Optional: leave it unset
# and Google sign-in is simply off — the app still runs and password login is
# unaffected.
#GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

LOGGING_LEVEL_COM_PROMPTVAULT=DEBUG

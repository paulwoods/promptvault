# Prompt Vault — environment configuration template.
#
# Copy this file to `.env` (git-ignored) for local development. The values
# below are DEV-ONLY and safe to use locally. NEVER reuse them outside local
# development, and never commit a real `.env`.
#
# - docker-compose reads this directory's `.env` automatically for the
#   POSTGRES_* variables below.
# - The backend reads its configuration from the environment, so export these
#   into your shell before `./mvnw spring-boot:run` (e.g. `set -a; . ./.env; set +a`).

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/promptvault
SPRING_DATASOURCE_USERNAME=promptvault
SPRING_DATASOURCE_PASSWORD=xxxxxxxxx

# --- Encryption master key (ADR-0002) ---
# Base64-encoded 32 random bytes. Generate a real one with:
#   openssl rand -base64 32
# Dev-only value (do not use anywhere but local):
PROMPTVAULT_ENC_KEY=xxxxxxxx

# --- JWT signing secret (HS256, >= 256-bit) ---
# Generate a real one with:
#   openssl rand -base64 48
# Dev-only value (do not use anywhere but local):
PROMPTVAULT_JWT_SECRET=xxxxxxxx

LOGGING_LEVEL_COM_PROMPTVAULT=DEBUG
